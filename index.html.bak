<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0d1117">

  <link rel="icon" href="favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="apple-touch-icon" href="favicon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="NEMO : THE LAST RECORD">
  <meta property="og:title" content="NEMO : THE LAST RECORD">
  <meta property="og:description" content="――ねもが生まれた日、世界は終わった。ねもの出生の秘密をたどる、記録復元型ノベルゲーム。">
  <meta property="og:url" content="https://haine-cpu7.github.io/nemo-the-last-record/">
  <meta property="og:image" content="https://haine-cpu7.github.io/nemo-the-last-record/ogp.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="NEMO : THE LAST RECORD">
  <meta name="twitter:description" content="――ねもが生まれた日、世界は終わった。ねもの出生の秘密をたどる、記録復元型ノベルゲーム。">
  <meta name="twitter:image" content="https://haine-cpu7.github.io/nemo-the-last-record/ogp.png">
  <title>NEMO : THE LAST RECORD</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div id="app">
    <canvas id="fxCanvas" aria-hidden="true"></canvas>
    <div class="noise"></div>
    <div id="blackout" class="blackout" aria-hidden="true"></div>
    <div id="recoveryOverlay" class="recovery-overlay hidden" aria-hidden="true">
      <div class="recovery-card">
        <div id="recoveryRec" class="recovery-rec">REC-000</div>
        <div id="recoveryTitle" class="recovery-title">RECOVERING</div>
        <div class="recovery-bar"><div id="recoveryFill" class="recovery-fill"></div></div>
        <div id="recoveryPercent" class="recovery-percent">0%</div>
      </div>
    </div>
    <div id="hiddenSignal" class="hidden-signal hidden">WORLD-0137 / SUBJECT : NEMO / STATUS : ACTIVE</div>

    <header id="topbar" class="hidden">
      <div class="top-left">
        <button id="archiveBtn" class="ghost">ARCHIVE</button>
        <button id="skipBtn" class="ghost hidden">SKIP: OFF</button>
      </div>
      <div id="recordStatus">RECORD 000</div>
      <div class="top-right">
        <button id="soundBtn" class="ghost">SOUND: ON</button>
        <button id="menuBtn" class="ghost">MENU</button>
      </div>
    </header>

    <main>
      <section id="titleScreen" class="screen active">
        <div class="title-wrap">
          <div class="eyebrow">NEMO ARCHIVE SYSTEM</div>
          <h1>NEMO<br><span>THE LAST RECORD</span></h1>
          <p class="subtitle">――ねもが生まれた日、世界は終わった。</p>
          <div class="menu">
            <button id="newGameBtn" class="main-btn">NEW GAME</button>
            <button id="continueBtn" class="main-btn" disabled>CONTINUE</button>
            <button id="recordNemoBtn" class="main-btn secret hidden">RECORD NEMO</button>
          </div>
          <p class="small">v0.3 / CINEMATIC RECORD EDITION<br>A record reconstruction visual novel.</p>
        </div>
      </section>

      <section id="gameScreen" class="screen">
        <div class="terminal">
          <div id="chapterLabel" class="chapter-label">RECORD 000</div>
          <div id="sceneTitle" class="scene-title">UNKNOWN FILE</div>
          <div id="visual" class="visual">
            <div id="visualIcon" class="visual-icon">◌</div>
            <div id="visualText" class="visual-text">NO IMAGE DATA</div>
          </div>

          <div id="dialogueBox" class="dialogue-box">
            <div id="speaker" class="speaker"></div>
            <div id="text" class="text"></div>
            <div id="choices" class="choices"></div>
            <button id="nextBtn" class="next-btn">NEXT</button>
          </div>
        </div>
      </section>

      <section id="archiveScreen" class="screen overlay-screen">
        <div class="panel wide">
          <div class="panel-head">
            <div>
              <div class="eyebrow">RECOVERED FILES</div>
              <h2>ARCHIVE</h2>
            </div>
            <button id="closeArchiveBtn" class="ghost">CLOSE</button>
          </div>
          <div id="archiveList" class="archive-list"></div>
        </div>
      </section>

      <section id="recordScreen" class="screen overlay-screen">
        <div class="panel wide">
          <div class="panel-head">
            <div>
              <div class="eyebrow">POST-CLEAR INDEX</div>
              <h2>RECORD NEMO</h2>
            </div>
            <button id="closeRecordBtn" class="ghost">CLOSE</button>
          </div>
          <div class="record-message">
            <p>これは、王女の記録ではない。</p>
            <p>ねもが、この世界で生きた記録だ。</p>
          </div>
          <div id="recordList" class="archive-list"></div>
        </div>
      </section>

      <section id="menuScreen" class="screen overlay-screen">
        <div class="panel">
          <div class="eyebrow">SYSTEM</div>
          <h2>MENU</h2>
          <button id="saveBtn" class="main-btn">SAVE</button>
          <button id="returnTitleBtn" class="main-btn">TITLE</button>
          <button id="closeMenuBtn" class="main-btn">RETURN</button>
        </div>
      </section>

      <section id="endingScreen" class="screen">
        <div class="ending-wrap">
          <div class="eyebrow">FINAL RECORD</div>
          <h2 id="endingTitle">END</h2>
          <div id="endingText" class="ending-text"></div>
          <button id="endingTitleBtn" class="main-btn">TITLE</button>
        </div>
      </section>
    </main>

    <footer id="footerHint" class="hidden">Tap NEXT / 画面を進めて記録を復元してください</footer>
  </div>

  <script src="game.js"></script>
</body>
</html>
