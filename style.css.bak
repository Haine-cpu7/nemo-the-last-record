
:root{
  --bg:#0b0f14;
  --panel:#101720;
  --panel2:#141d27;
  --line:#293545;
  --text:#e7edf5;
  --muted:#8997a8;
  --accent:#cfd9e6;
  --soft:#1c2733;
  --danger:#8d3030;
  --shadow:0 20px 60px rgba(0,0,0,.42);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}
body{min-height:100vh;overflow-x:hidden}
button{font:inherit}
#app{min-height:100vh;position:relative;background:
radial-gradient(circle at 50% 20%,rgba(255,255,255,.03),transparent 28%),
linear-gradient(180deg,#0d1218,#080b0f)}
.noise{pointer-events:none;position:fixed;inset:0;opacity:.05;z-index:50;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E")}
.hidden{display:none!important}
.screen{display:none;min-height:100vh;padding:72px 20px 64px}
.screen.active{display:flex}
#titleScreen{align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden}
#titleScreen::before{
  content:"";
  position:absolute; inset:0;
  background:
    linear-gradient(180deg,rgba(3,7,12,.72),rgba(4,8,14,.84)),
    radial-gradient(circle at center, rgba(255,255,255,.05), transparent 42%),
    url("title-hero.png");
  background-size:cover;
  background-position:center center;
  filter:saturate(.88) brightness(.60);
}
#titleScreen::after{
  content:"";
  position:absolute; inset:0;
  background:
    linear-gradient(180deg, rgba(4,8,14,.28) 0%, rgba(5,8,14,.46) 42%, rgba(5,8,14,.80) 100%);
  pointer-events:none;
}
.title-wrap{width:min(760px,100%);position:relative;z-index:1;padding:26px 30px;background:rgba(6,10,16,.34);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.10);box-shadow:0 18px 60px rgba(0,0,0,.36)}
.eyebrow{font-size:11px;letter-spacing:.32em;color:var(--muted);margin-bottom:16px}
h1{font-size:clamp(46px,10vw,98px);line-height:.84;margin:0;letter-spacing:-.045em;font-weight:800}
h1 span{font-size:.32em;letter-spacing:.22em;color:var(--muted);font-weight:500}
.subtitle{margin:28px 0 34px;color:#bac5d1;letter-spacing:.08em}
.menu{width:min(320px,100%);margin:0 auto;display:grid;gap:12px}
.main-btn,.ghost,.next-btn{border:1px solid var(--line);background:transparent;color:var(--text);cursor:pointer;transition:.18s ease}
.main-btn{padding:14px 18px;letter-spacing:.16em;background:rgba(255,255,255,.015)}
.main-btn:hover,.ghost:hover,.next-btn:hover{background:var(--soft);border-color:#4a5d72}
.main-btn:disabled{opacity:.25;cursor:not-allowed}
.main-btn.secret{border-color:#63572e}
.small{font-size:11px;color:#687687;margin-top:28px;letter-spacing:.14em}
#topbar{position:fixed;left:0;right:0;top:0;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(8,12,16,.82);backdrop-filter:blur(10px);z-index:20}
#recordStatus{font-size:11px;letter-spacing:.2em;color:var(--muted)}
.ghost{padding:8px 10px;font-size:11px;letter-spacing:.14em}
#gameScreen{align-items:center;justify-content:center}
.terminal{width:min(900px,100%);margin:auto}
.chapter-label{font-size:11px;letter-spacing:.28em;color:var(--muted);margin-bottom:8px}
.scene-title{font-size:clamp(22px,4vw,36px);font-weight:700;margin-bottom:18px;letter-spacing:.04em}
.visual{min-height:230px;border:1px solid var(--line);background:
linear-gradient(135deg,rgba(255,255,255,.02),transparent 38%),
linear-gradient(180deg,#121a23,#0f151c);
display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.visual:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(255,255,255,.012) 50%);background-size:100% 4px;pointer-events:none}
.visual-icon{font-size:52px;color:#aab8c6;opacity:.85}
.visual-text{font-size:12px;letter-spacing:.18em;color:#7f8c9a;text-align:center;padding:0 20px}
.dialogue-box{margin-top:16px;border:1px solid var(--line);background:rgba(16,23,32,.94);padding:22px;min-height:250px;position:relative;box-shadow:var(--shadow)}
.speaker{font-size:12px;letter-spacing:.15em;color:#91a3b4;min-height:20px;margin-bottom:10px}
.text{font-size:16px;line-height:2;white-space:pre-wrap;min-height:110px}
.choices{display:grid;gap:10px;margin-top:18px}
.choice{width:100%;text-align:left;padding:13px 14px;border:1px solid var(--line);background:#0f161e;color:var(--text);cursor:pointer}
.choice:hover{background:#192330}
.next-btn{display:block;margin:22px 0 0 auto;padding:10px 22px;letter-spacing:.16em}
.overlay-screen{position:fixed;inset:0;background:rgba(5,8,12,.94);z-index:30;align-items:flex-start;justify-content:center;overflow:auto;padding:72px 20px 32px}
.panel{width:min(430px,100%);border:1px solid var(--line);background:var(--panel);padding:24px;box-shadow:var(--shadow);margin:0 auto;max-height:calc(100vh - 104px);overflow:auto}
.panel.wide{width:min(880px,100%)}
.panel h2{margin:0 0 20px;font-size:32px}
.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;position:sticky;top:-24px;background:linear-gradient(180deg,var(--panel) 0%, var(--panel) 82%, rgba(16,23,32,0) 100%);padding-top:4px;padding-bottom:12px;z-index:2}
.archive-list{display:grid;gap:10px;margin-top:22px}
.archive-item{border:1px solid var(--line);padding:15px;background:#0d141b}
.archive-item.locked{opacity:.28}
.archive-id{font-size:10px;letter-spacing:.18em;color:var(--muted)}
.archive-title{font-size:15px;font-weight:700;margin:6px 0}
.archive-body{font-size:13px;line-height:1.8;color:#b8c3ce}
.record-message{border-left:2px solid #4d5966;padding-left:16px;color:#bdc7d1;line-height:1.9}
#menuScreen .panel{display:grid;gap:12px}
#menuScreen h2{margin-bottom:8px}
#endingScreen{align-items:center;justify-content:center;text-align:center}
.ending-wrap{width:min(760px,100%)}
.ending-wrap h2{font-size:clamp(38px,7vw,70px);margin:10px 0 28px}
.ending-text{white-space:pre-wrap;line-height:2.1;color:#d4dce5;margin-bottom:34px}
#footerHint{position:fixed;bottom:0;left:0;right:0;text-align:center;padding:10px;color:#536171;font-size:10px;letter-spacing:.08em;background:linear-gradient(transparent,rgba(8,11,15,.85));z-index:10}
@media(max-width:640px){
  .screen{padding:68px 14px 54px}
  .visual{min-height:180px}
  .dialogue-box{padding:18px;min-height:290px}
  .text{font-size:15px;line-height:1.9}
  .overlay-screen{padding:64px 12px 18px}
  .panel{padding:18px;max-height:calc(100vh - 82px)}
  .panel-head{align-items:center;top:-18px}
}


@media(max-width:640px){
  .title-wrap{padding:20px 16px}
}


#titleScreen h1,
#titleScreen .subtitle,
#titleScreen .eyebrow,
#titleScreen .small{
  text-shadow:0 2px 16px rgba(0,0,0,.55);
}
#titleScreen h1{
  letter-spacing:-.04em;
}
#titleScreen .subtitle{
  font-size:clamp(17px,2vw,22px);
}
#titleScreen .main-btn{
  background:rgba(6,10,16,.32);
  backdrop-filter:blur(2px);
}



/* =========================
   v0.3 CINEMATIC RECORD
   ========================= */

#fxCanvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:1;
  opacity:.72;
}
#app > main,
#topbar,
#footerHint{
  position:relative;
  z-index:3;
}
.noise{z-index:8}

.top-left,.top-right{display:flex;align-items:center;gap:8px}

.blackout{
  position:fixed;
  inset:0;
  z-index:90;
  background:#020305;
  opacity:0;
  pointer-events:none;
  transition:opacity .5s ease;
}
.blackout.active{opacity:1}
.blackout.flash{
  background:#e9f3ff;
  opacity:.92;
  transition:none;
}

.recovery-overlay{
  position:fixed;
  inset:0;
  z-index:80;
  background:rgba(2,5,9,.94);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
}
.recovery-card{
  width:min(520px,92vw);
  border:1px solid #334458;
  background:rgba(8,14,22,.86);
  padding:30px 28px;
  box-shadow:0 30px 90px rgba(0,0,0,.5);
  text-align:center;
  position:relative;
  overflow:hidden;
}
.recovery-card::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(transparent 50%,rgba(255,255,255,.025) 50%);
  background-size:100% 4px;
  pointer-events:none;
}
.recovery-rec{
  font-size:11px;
  letter-spacing:.28em;
  color:#78889a;
  margin-bottom:12px;
}
.recovery-title{
  font-size:20px;
  letter-spacing:.24em;
  color:#e4ebf2;
  margin-bottom:24px;
}
.recovery-bar{
  height:2px;
  background:#182431;
  overflow:hidden;
}
.recovery-fill{
  height:100%;
  width:0%;
  background:#dbe9f8;
  box-shadow:0 0 18px rgba(214,232,251,.85);
}
.recovery-percent{
  margin-top:12px;
  font-size:11px;
  letter-spacing:.24em;
  color:#8d9cae;
}

.hidden-signal{
  position:fixed;
  right:18px;
  bottom:16px;
  z-index:7;
  font-size:9px;
  letter-spacing:.17em;
  color:rgba(160,190,220,.62);
  text-shadow:0 0 12px rgba(110,170,230,.5);
  animation:signalBlink 2.2s infinite;
}
@keyframes signalBlink{
  0%,47%,53%,100%{opacity:.18}
  49%,51%{opacity:.9}
}

#gameScreen.cinematic-shake .terminal{
  animation:cinematicShake .42s linear;
}
@keyframes cinematicShake{
  0%,100%{transform:translate(0,0)}
  18%{transform:translate(-2px,1px)}
  36%{transform:translate(2px,-1px)}
  56%{transform:translate(-1px,-1px)}
  74%{transform:translate(1px,1px)}
}

.glitching{
  animation:glitchText .16s steps(2,end) 4;
}
@keyframes glitchText{
  0%{transform:translateX(0);filter:none}
  25%{transform:translateX(-2px);filter:brightness(1.7)}
  50%{transform:translateX(2px);filter:contrast(1.7)}
  75%{transform:translateX(-1px);filter:brightness(.7)}
  100%{transform:translateX(0);filter:none}
}

.visual.branching{
  background:
    radial-gradient(circle at 50% 75%,rgba(188,220,255,.13),transparent 32%),
    linear-gradient(180deg,#0d1520,#080d13);
  box-shadow:
    inset 0 0 70px rgba(95,145,200,.06),
    0 20px 60px rgba(0,0,0,.42);
}
.visual.signal-lost{
  border-color:#262b31;
  background:#050608;
}
.visual.signal-lost .visual-icon,
.visual.signal-lost .visual-text{
  color:#68707a;
  text-shadow:none;
}

#sceneTitle.impact{
  letter-spacing:.11em;
  text-shadow:0 0 24px rgba(190,220,250,.22);
}
.text.impact-line{
  font-size:clamp(17px,2vw,21px);
  line-height:2.15;
  letter-spacing:.03em;
}
.text.system-log{
  font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;
  font-size:14px;
  letter-spacing:.08em;
  color:#d3dfeb;
}
.text.soft-world{
  color:#eef3f7;
  text-shadow:0 0 18px rgba(255,255,255,.08);
}

.choices.final-choice{
  margin-top:24px;
  border-top:1px solid #243141;
  padding-top:16px;
}
.choices.final-choice::before{
  content:"AUTHORIZATION REQUIRED";
  display:block;
  margin-bottom:12px;
  font-size:10px;
  letter-spacing:.22em;
  color:#738396;
}
.choices.final-choice .choice{
  position:relative;
  padding:15px 16px 15px 46px;
  letter-spacing:.06em;
}
.choices.final-choice .choice::before{
  content:"□";
  position:absolute;
  left:18px;
  top:50%;
  transform:translateY(-50%);
  color:#8395a8;
}
.choices.final-choice .choice:hover::before{content:"■"}

.next-btn.waiting{
  opacity:.18;
  pointer-events:none;
}

#titleScreen.cleared-title::before{
  filter:saturate(.95) brightness(.67);
}
#titleScreen.cleared-title::after{
  background:
    linear-gradient(180deg,rgba(3,7,12,.18),rgba(4,8,14,.52) 48%,rgba(5,8,14,.78));
}
#titleScreen.cleared-title .title-wrap{
  border-color:rgba(170,205,240,.18);
  box-shadow:0 18px 70px rgba(35,80,130,.14);
}

@media(max-width:640px){
  .top-left,.top-right{gap:4px}
  #topbar .ghost{padding:7px 7px;font-size:9px}
  .hidden-signal{right:10px;bottom:10px;font-size:7px}
}



/* ===== v0.3.2 scene image support ===== */
.visual.has-image{
  position:relative;
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;
  justify-content:flex-end;
  align-items:flex-start;
  padding:18px;
  overflow:hidden;
}
.visual.has-image::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg, rgba(4,8,14,.24) 0%, rgba(4,8,14,.08) 30%, rgba(4,8,14,.24) 65%, rgba(4,8,14,.58) 100%);
  pointer-events:none;
}
.visual.has-image::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(transparent 50%,rgba(255,255,255,.012) 50%);
  background-size:100% 4px;
  pointer-events:none;
}
.visual.has-image .visual-icon{
  display:none;
}
.visual.has-image .visual-text{
  position:relative;
  z-index:1;
  margin-top:auto;
  align-self:flex-start;
  text-align:left;
  font-size:10px;
  letter-spacing:.24em;
  color:#dfe7ef;
  background:rgba(6,10,16,.42);
  border:1px solid rgba(255,255,255,.08);
  padding:8px 10px;
  backdrop-filter:blur(3px);
  text-shadow:0 1px 10px rgba(0,0,0,.42);
}


@media(max-width:640px){
  .visual.has-image{
    min-height:220px;
    background-position:center center;
  }
  .visual.has-image .visual-text{
    font-size:9px;
    letter-spacing:.18em;
    padding:7px 8px;
    max-width:82%;
  }
}


/* v0.3.9 mobile image fix */
@media(max-width:640px){
  .visual.has-image{
    background-position:center center;
    min-height:240px;
  }
}
